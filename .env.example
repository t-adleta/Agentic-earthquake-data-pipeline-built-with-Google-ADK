# Copy this file to .env and fill in your own values. .env is git-ignored.

# --- Gemini (required to run the agents) ---
# Get a free key at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-gemini-api-key
# Model the agents use. gemini-3.6-flash responds reliably on the free tier;
# remove this line to fall back to the default (gemini-3.8-flash).
PIPELINE_MODEL=gemini-3.6-flash

# --- Cloud storage ---
# gcs = Google Cloud Storage, s3 = AWS S3
STORAGE_BACKEND=gcs
# Leave empty to skip uploads and keep everything local.
BUCKET_NAME=your-bucket-name
# Optional folder prefix inside the bucket
# BUCKET_PREFIX=earthquakes

# GCS auth: run `gcloud auth application-default login` (no key file needed).
# S3 auth: run `aws configure`, or set AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY /
# AWS_DEFAULT_REGION in your shell (not in this repo).
